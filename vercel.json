{
  "headers": [
    { "source": "/app", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/app.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/api/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
      { "key": "X-XSS-Protection", "value": "1; mode=block" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" }
    ]}
  ],
  "functions": {
    "api/whatsapp-webhook.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/anamnese", "destination": "/anamnese.html" },
    { "source": "/checkin", "destination": "/checkin.html" },
    { "source": "/validador", "destination": "/validador.html" },
    { "source": "/assinar", "destination": "/assinar.html" },
    { "source": "/api/cron-followup", "destination": "/api/cron-confirmacoes?tarefa=followup" }
  ],
  "crons": [
    {
      "path": "/api/cron-confirmacoes",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron-followup",
      "schedule": "10 13 * * *"
    }
  ]
}
